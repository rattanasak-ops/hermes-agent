{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/wrk-gov-v1/worktree-registry-v2.schema.json",
  "title": "WRK-GOV-V1 Worktree Registry v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "standard_version", "authority", "updated_at", "tasks", "history"],
  "properties": {
    "schema_version": {"const": "worktree-registry-v2"},
    "standard_version": {"const": "WRK-GOV-V1"},
    "authority": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "tasks": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/task"}
    },
    "history": {
      "type": "array",
      "items": {"$ref": "#/$defs/historyEvent"}
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "task_id",
        "staff_id",
        "branch",
        "base_branch",
        "state",
        "placements",
        "write_lease",
        "recovery",
        "history"
      ],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "staff_id": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "base_branch": {"type": "string", "minLength": 1},
        "state": {
          "enum": [
            "INVENTORY",
            "FROZEN",
            "PRESERVED",
            "ACTIVE",
            "PAUSED",
            "IN_REVIEW",
            "MERGED",
            "ABANDONED_BY_OWNER",
            "CLEANUP_PROPOSED",
            "QUARANTINED",
            "ARCHIVED",
            "BLOCKED"
          ]
        },
        "placements": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/placement"}
        },
        "write_lease": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/writeLease"}
          ]
        },
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["remote_url", "remote_branch", "remote_sha", "evidence"],
          "properties": {
            "remote_url": {"type": ["string", "null"]},
            "remote_branch": {"type": ["string", "null"]},
            "remote_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$"},
            "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "history": {
          "type": "array",
          "items": {"$ref": "#/$defs/historyEvent"}
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placement_id",
        "machine_id",
        "mode",
        "canonical_repo",
        "worktree_path",
        "remote_alias",
        "sha",
        "dirty",
        "dirty_entry_count",
        "unpushed_count",
        "status",
        "last_seen_at",
        "runtime",
        "disk",
        "cleanup"
      ],
      "properties": {
        "placement_id": {"type": "string", "minLength": 1},
        "machine_id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["writer", "runtime", "review", "archive"]},
        "canonical_repo": {"type": "string", "pattern": "^/"},
        "worktree_path": {"type": "string", "pattern": "^/"},
        "remote_alias": {"type": "string", "minLength": 1},
        "sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$"},
        "dirty": {"type": ["boolean", "null"]},
        "dirty_entry_count": {"type": ["integer", "null"], "minimum": 0},
        "unpushed_count": {"type": ["integer", "null"], "minimum": 0},
        "status": {"enum": ["available", "broken", "missing", "quarantined", "archived"]},
        "last_seen_at": {"type": "string", "format": "date-time"},
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["processes", "services", "ports", "containers", "databases"],
          "properties": {
            "processes": {"type": "array", "items": {"type": "string"}},
            "services": {"type": "array", "items": {"type": "string"}},
            "ports": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 65535}},
            "containers": {"type": "array", "items": {"type": "string"}},
            "databases": {"type": "array", "items": {"type": "string"}}
          }
        },
        "disk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total_bytes", "measured_at"],
          "properties": {
            "total_bytes": {"type": "integer", "minimum": 0},
            "measured_at": {"type": "string", "format": "date-time"}
          }
        },
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["eligible", "gates", "dry_run_at", "quarantine_until"],
          "properties": {
            "eligible": {"type": "boolean"},
            "gates": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "clean_or_archived",
                "pushed_or_archived",
                "no_writer_or_runtime",
                "merged_or_owner_abandoned",
                "recovery_evidence",
                "dry_run_recorded"
              ],
              "properties": {
                "clean_or_archived": {"type": "boolean"},
                "pushed_or_archived": {"type": "boolean"},
                "no_writer_or_runtime": {"type": "boolean"},
                "merged_or_owner_abandoned": {"type": "boolean"},
                "recovery_evidence": {"type": "boolean"},
                "dry_run_recorded": {"type": "boolean"}
              }
            },
            "dry_run_at": {"type": ["string", "null"], "format": "date-time"},
            "quarantine_until": {"type": ["string", "null"], "format": "date-time"}
          }
        }
      }
    },
    "writeLease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lease_id", "staff_id", "machine_id", "placement_id", "claimed_at", "expires_at"],
      "properties": {
        "lease_id": {"type": "string", "minLength": 1},
        "staff_id": {"type": "string", "minLength": 1},
        "machine_id": {"type": "string", "minLength": 1},
        "placement_id": {"type": "string", "minLength": 1},
        "claimed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "historyEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "actor", "action", "evidence"],
      "properties": {
        "at": {"type": "string", "format": "date-time"},
        "actor": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
