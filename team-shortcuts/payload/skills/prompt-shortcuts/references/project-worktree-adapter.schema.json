{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/wrk-gov-v1/project-worktree-adapter.schema.json",
  "title": "WRK-GOV-V1 Project Worktree Adapter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "standard_version",
    "project_id",
    "display_name",
    "repository",
    "machines",
    "default_writer_machine_id",
    "runtime_machine_id",
    "verification",
    "protected_paths",
    "disk_thresholds",
    "cleanup"
  ],
  "properties": {
    "schema_version": {"const": "wrk-gov-project-adapter-v1"},
    "standard_version": {"const": "WRK-GOV-V1"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"},
    "display_name": {"type": "string", "minLength": 1},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_urls", "base_branch", "protected_branches", "branch_patterns"],
      "properties": {
        "owner_urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "base_branch": {"type": "string", "minLength": 1},
        "protected_branches": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "branch_patterns": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task", "rescue", "hotfix"],
          "properties": {
            "task": {"const": "task/<staff-id>/<task-id>-<slug>"},
            "rescue": {"const": "rescue/<staff-id>/<incident-id>-<slug>"},
            "hotfix": {"const": "hotfix/<staff-id>/<task-id>-<slug>"}
          }
        }
      }
    },
    "machines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "machine_id",
          "kind",
          "role",
          "canonical_repo",
          "worktree_roots",
          "remote_alias",
          "runtime_root"
        ],
        "properties": {
          "machine_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"},
          "kind": {"enum": ["owner_notebook", "staff_notebook", "vps", "other"]},
          "role": {"enum": ["writer", "runtime", "reviewer"]},
          "canonical_repo": {"type": "string", "pattern": "^/"},
          "worktree_roots": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^/"}
          },
          "remote_alias": {"type": "string", "minLength": 1},
          "runtime_root": {"type": ["string", "null"], "pattern": "^/"}
        }
      }
    },
    "default_writer_machine_id": {"type": "string", "minLength": 1},
    "runtime_machine_id": {"type": "string", "minLength": 1},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_only_checks", "test_commands"],
      "properties": {
        "read_only_checks": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "test_commands": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "protected_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "disk_thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warn_percent", "freeze_new_worktrees_percent", "recovery_percent"],
      "properties": {
        "warn_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "freeze_new_worktrees_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "recovery_percent": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manager_only", "quarantine_hours", "gate_count"],
      "properties": {
        "manager_only": {"const": true},
        "quarantine_hours": {"type": "integer", "minimum": 72},
        "gate_count": {"const": 6}
      }
    }
  }
}
